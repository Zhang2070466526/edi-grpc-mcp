    "Var": {
      "display_name": "变量定义控制器",
      "parameters": {},
      "parameter_patterns": [
        {
          "public_pattern": "{name}",
          "wire_pattern": "{name}",
          "description": "变量名由用户自定义（如 Pin、freq1、Vb），直接作为 parameters 的键，不要使用 SetValues 或 VarName 之类的包裹键；值为 {\"value\": \"<数值或表达式>\"}，变量记录没有单位字段，unit 不可写。一次提交可定义多个变量。Sweep 的 SweepVar 必须等于这里定义的某个键名，否则写入报 SweepVar <name> was not found in existing Var components。",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": false,
          "update_allowed": true
        }
      ],
      "example": {
        "freq1": {
          "value": "10"
        },
        "Pin": {
          "value": "-20"
        }
      }
    }
  }
}
