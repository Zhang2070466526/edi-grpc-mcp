{
  "components": {
    "SParameter": {
      "display_name": "S 参数仿真控制器",
      "parameters": {
        "Start": {
          "wire_name": "Start",
          "description": "扫描起始频率",
          "value_type": "string",
          "unit_required": true,
          "units": [
			"None",
            "Hz",
            "kHz",
            "MHz",
            "GHz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "Stop": {
          "wire_name": "Stop",
          "description": "扫描终止频率",
          "value_type": "string",
          "unit_required": true,
          "units": [
			"None",
            "Hz",
            "kHz",
            "MHz",
            "GHz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "Step": {
          "wire_name": "Step",
          "description": "扫描步长",
          "value_type": "string",
          "unit_required": true,
          "units": [
			"None",
            "Hz",
            "kHz",
            "MHz",
            "GHz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "Pts": {
          "wire_name": "Pts",
          "description": "扫描点数，根据Start Stop和Step计算得出",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "CalcS": {
          "wire_name": "CalcS",
          "description": "是否计算 S 参数,用户无要求时无需传入该变量",
          "value_type": "boolean",
          "unit_required": false,
          "units": [],
          "enum_values": [
            "yes",
            "no"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "CalcNoise": {
          "wire_name": "CalcNoise",
          "description": "是否计算噪声系数,用户无要求时无需传入该变量",
          "value_type": "boolean",
          "unit_required": false,
          "units": [],
          "enum_values": [
            "yes",
            "no"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "CalcGroupDelay": {
          "wire_name": "CalcGroupDelay",
          "description": "是否计算群时延,用户无要求时无需传入该变量",
          "value_type": "boolean",
          "unit_required": false,
          "units": [],
          "enum_values": [
            "yes",
            "no"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "EnforcePassivity": {
          "wire_name": "EnforcePassivity",
          "description": "是否强制执行无源性,用户无要求时无需传入该变量",
          "value_type": "boolean",
          "unit_required": false,
          "units": [],
          "enum_values": [
            "yes",
            "no"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "FreqConversion": {
          "wire_name": "FreqConversion",
          "description": "是否启用频率转换,用户无要求时无需传入该变量",
          "value_type": "boolean",
          "unit_required": false,
          "units": [],
          "enum_values": [
            "yes",
            "no"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "NoiseInputPort": {
          "wire_name": "NoiseInputPort",
          "description": "噪声输入端口号,用户无要求时无需传入该变量",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "NoiseOutputPort": {
          "wire_name": "NoiseOutputPort",
          "description": "噪声输出端口号,用户无要求时无需传入该变量",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "FreqConversionPort": {
          "wire_name": "FreqConversionPort",
          "description": "频率转换端口号,用户无要求时无需传入该变量",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "BandwidthForNoise": {
          "wire_name": "BandwidthForNoise",
          "description": "噪声带宽,用户无要求时无需传入该变量",
          "value_type": "number",
          "unit_required": true,
          "units": [
			"None",
            "Hz",
            "kHz",
            "MHz",
            "GHz"
          ],
          "create_allowed": false,
          "update_allowed": false
        },
        "GroupDelayAperture": {
          "wire_name": "GroupDelayAperture",
          "description": "群时延孔径,用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        }
      },
      "parameter_patterns": [],
      "example": {
        "Start": {
          "value": "8",
          "unit": "GHz"
        },
        "Stop": {
          "value": "12",
          "unit": "GHz"
        },
        "Step": {
          "value": "0.1",
          "unit": "GHz"
        },
        "Pts": {
          "value": "41"
        },
        "CalcS": {
          "value": "yes"
        },
        "CalcNoise": {
          "value": "yes"
        },
        "CalcGroupDelay": {
          "value": "no"
        },
        "EnforcePassivity": {
          "value": "no"
        },
        "FreqConversion": {
          "value": "no"
        },
        "FreqConversionPort": {
          "value": "1"
        },
        "NoiseInputPort": {
          "value": "2"
        },
        "NoiseOutputPort": {
          "value": "1"
        },
        "GroupDelayAperture": {
          "value": "1e-4"
        }
      }
    },
    "HarmonicBalance": {
      "display_name": "谐波平衡控制器",
      "parameters": {
        "Freq": {
          "wire_name": "Freq[1]",
          "description": "基频频率（同 Freq[1]），可为变量名",
          "value_type": "string",
          "unit_required": true,
          "units": [
            "None",
            "Hz",
            "kHz",
            "MHz",
            "GHz",
            "THz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "Order": {
          "wire_name": "Order[1]",
          "description": "谐波阶数（同 Order[1]）",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "InputFreq": {
          "wire_name": "InputFreq",
          "description": "噪声分析输入频率，可为变量名,用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": true,
          "units": [
            "None",
            "Hz",
            "kHz",
            "MHz",
            "GHz",
            "THz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "NoiseInputPort": {
          "wire_name": "NoiseInputPort",
          "description": "噪声分析输入端口号,用户无要求时无需传入该变量",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "NoiseOutputPort": {
          "wire_name": "NoiseOutputPort",
          "description": "噪声分析输出端口号,用户无要求时无需传入该变量",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "Noise_Start": {
          "wire_name": "Noise_Start",
          "description": "噪声频率扫描起始频率；SweepType=Single Point 时作为 FreqForNoise，SweepType=Linear 时作为 SweepPlan 起始值,用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": true,
          "units": [
            "None",
            "Hz",
            "kHz",
            "MHz",
            "GHz",
            "THz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "Noise_Step": {
          "wire_name": "Noise_Step",
          "description": "噪声频率扫描步长；仅 SweepType=Linear 时写入网表 SweepPlan,用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": true,
          "units": [
            "None",
            "Hz",
            "kHz",
            "MHz",
            "GHz",
            "THz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "Noise_Stop": {
          "wire_name": "Noise_Stop",
          "description": "噪声频率扫描终止频率；仅 SweepType=Linear 时写入网表 SweepPlan,用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": true,
          "units": [
            "None",
            "Hz",
            "kHz",
            "MHz",
            "GHz",
            "THz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        "NonlinearNoise": {
          "wire_name": "NonlinearNoise",
          "description": "非线性噪声开关（实测取值：no；值域未确认）,用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "SweepType": {
          "wire_name": "SweepType",
          "description": "噪声频率扫描类型，取值 Linear 或 Single Point；Single Point 时网表只取 InputFreq/Noise_Start/NoiseInputPort/NoiseOutputPort，Linear 时另生成 NoiseFreqPlan 与 SweepPlan(Noise_Start/Noise_Stop/Noise_Step),用户无要求时无需传入该变量",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "enum_values": [
            "Linear",
            "Single Point"
          ],
          "create_allowed": true,
          "update_allowed": true
        }
      },
      "parameter_patterns": [
        {
          "public_pattern": "Freq[{index}]",
          "wire_pattern": "Freq[{index}]",
          "index_min": 1,
          "index_max": 32,
          "description": "第 N 个基频频率",
          "value_type": "string",
          "unit_required": true,
          "units": [
            "None",
            "Hz",
            "kHz",
            "MHz",
            "GHz",
            "THz"
          ],
          "create_allowed": true,
          "update_allowed": true
        },
        {
          "public_pattern": "Order[{index}]",
          "wire_pattern": "Order[{index}]",
          "index_min": 1,
          "index_max": 32,
          "description": "第 N 个谐波阶数",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        }
      ],
      "example": {
        "Freq": {
          "value": "Freq",
          "unit": "GHz"
        },
        "Order": {
          "value": "5"
        },
        "InputFreq": {
          "value": "noisefreq",
          "unit": "None"
        },
        "NoiseInputPort": {
          "value": "1"
        },
        "NoiseOutputPort": {
          "value": "2"
        },
        "Noise_Start": {
          "value": "1.0",
          "unit": "GHz"
        },
        "Noise_Step": {
          "value": "1.0",
          "unit": "GHz"
        },
        "Noise_Stop": {
          "value": "10.0",
          "unit": "GHz"
        },
        "NonlinearNoise": {
          "value": "no"
        },
        "SweepType": {
          "value": "Linear"
        }
      }
    },
    "XDB": {
