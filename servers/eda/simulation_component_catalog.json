    "Sweep": {
      "display_name": "参数扫描控制器",
      "parameters": {
        "SweepVar": {
          "wire_name": "SweepVar",
          "description": "扫描变量名（实测取值：Freq、X）",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "Start": {
          "wire_name": "Start",
          "description": "扫描起始值；参数记录中不含单位字段，无单位可写",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "Stop": {
          "wire_name": "Stop",
          "description": "扫描终止值；参数记录中不含单位字段，无单位可写",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "Step": {
          "wire_name": "Step",
          "description": "扫描步长；参数记录中不含单位字段，无单位可写",
          "value_type": "string",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        },
        "Pts": {
          "wire_name": "Pts",
          "description": "扫描点数；参数记录中不含单位字段",
          "value_type": "integer",
          "unit_required": false,
          "units": [],
          "create_allowed": true,
          "update_allowed": true
        }
      },
      "parameter_patterns": [
